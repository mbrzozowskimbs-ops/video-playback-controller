{
  "manifest_version": 3,
  "name": "video-playback-controller",
  "version": "1.5.0",
  "description": "Przewijanie i pauza w PLAY NOW przyciskami oraz klawiaturą. Działa wyłącznie na playnow.pl.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-playback-controller@local.invalid",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/mbrzozowskimbs-ops/video-playback-controller/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "host_permissions": [
    "https://playnow.pl/*"
  ],
  "action": {
    "default_title": "video-playback-controller — sterowanie PLAY NOW",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playnow.pl/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
